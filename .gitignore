# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# Local academic documents, reference PDFs and voice notes. Keep on disk,
# outside version control; application code and model artifacts remain tracked.
*.[pP][dD][fF]
*.ogg
*.m4a
*.mp3
*.wav

# Regenerable report outputs; editable Markdown, diagram definitions, styles,
# scripts, brand source images and saved JSON test evidence remain tracked.
report/dist/
report/assets/screens/
report/assets/figures/
report/assets/charts/
report/assets/code/
report/reference/images/
report/data/qa-screens/
report/data/notebook-run.ipynb

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# auto-generated by `next dev`
AGENTS.md
CLAUDE.md
